# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# OpenAI model (must support the Responses API and reasoning). Default: gpt-5
# OPENAI_MODEL=gpt-5

# Reasoning effort: minimal | low | medium | high (default medium)
# ASSISTANT_EFFORT=medium

# NMI gateway base URL used by Swytchcode in sandbox mode (non-secret).
# Sandbox: https://sandbox.nmi.com/api   Production: https://secure.nmi.com/api
SWYTCHCODE_BASE_URL_NMI_NMI_SANDBOX=https://sandbox.nmi.com/api

# NMI credentials do NOT go here. Connect them once with:
#   swytchcode auth connect nmi
